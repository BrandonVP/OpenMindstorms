# Files that run inside Linux containers must keep LF endings even when
# checked out or archived on Windows (git archive applies these rules too).
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.lgo       text eol=lf
*.exe       binary
*.pdf       binary
*.rcx       binary
